{
  "name": "lukaszkups/http-router-demo",
  "description": "Mini front controller + router for the PHP 2026 tutorial",
  "type": "project",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "start": "php -S localhost:8080 -t public public/index.php"
  }
}
